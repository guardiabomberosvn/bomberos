NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=TU-PUBLISHABLE-KEY

# Bot de Telegram para alertas de emergencia (opcional). Creado con
# @BotFather en Telegram. Ver README para instrucciones.
NEXT_PUBLIC_TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Clave secreta de Supabase, SOLO para el webhook de Telegram (nunca se usa
# en el navegador). Se obtiene en Supabase > Project Settings > API >
# service_role. NUNCA le pongas el prefijo NEXT_PUBLIC_ a esta variable.
SUPABASE_SERVICE_ROLE_KEY=
